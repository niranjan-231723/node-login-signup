
<html>
    <head>
        <link rel="stylesheet" href="/form.css" >
    </head>
    <body>
        <div class="flexbox">
        <div class="innerbox">
        <form>
        <h1>create account</h1>
        </br>
        <label for="email">Enter the email </label>
        <input id="email" name="email" type="email">
        <div class="emailerror"> </div>
        <label for="password">Enter the password </label>
        <input id="password" name="password" type="password">
        <div  class="passworderror"> </div>
        <button  type="submit" class="signup">signup</button>
        <button  type="button" class="signin">signin</button>
        <button type="button" class="resetbutton">forgot password</button>
        </form>
        </div>

        </div>

    </body>
</html>

<script> 

    const form=document.querySelector("form")
    const emailerror=document.querySelector(".emailerror")
    const passworderror=document.querySelector(".passworderror")
    const resetbutton=document.querySelector(".resetbutton")
    const signin=document.querySelector(".signin")
    form.addEventListener("submit",async (e)=>{
        emailerror.textContent=""
        passworderror.textContent=""
            emailerror.textContent=""
            passworderror.textContent=""
            console.log("submitted")

        e.preventDefault()
        try{
            const data=await fetch("/signup",{
            method:"POST",
            headers:{"content-type":"application/json"},
            body:JSON.stringify({email:form.email.value,password:form.password.value}

             )})
             
        
        const map=await data.json()

        if (map.email){
          emailerror.textContent=map.email
        }

        if(map.password){
            passworderror.textContent=map.password
        }
    }
    catch(err){
            console.log(err.email)
         }
    })

    resetbutton.addEventListener("click",()=>{
       window.location.assign("/resetpasswordpage")
    })
    

    signin.addEventListener("click",(e)=>{
        window.location.assign("/signin")
    })
     
</script>




     
