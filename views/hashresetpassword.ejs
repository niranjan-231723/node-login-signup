<html>
    <head>
        <title>hash reset password</title>
        <link rel="stylesheet" href="/resetpass.css">

    </head>
    <body>
        <div class="main">
        <div class="box">
        <h1> set new password</h1>
        <form action="/hashresetpassword/<%= token %>" method="POST">
            <label>Enter the new password</label>
            <input type="password" required name="opassword">
            <label>reenter the new password</label>
            <input required type="password" name ="npassword">
            <button>submit</button>
        </form>
        </div>
        </div>


    </body>
</html>



